# Contact form (server-side only — never prefix these with NEXT_PUBLIC_)
# Copy this file to .env.local for local development, and add the same values
# to your hosting provider (e.g. Vercel) for production.

# Inbox that receives messages submitted through the portfolio contact form.
CONTACT_EMAIL=you@example.com

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Verified sender in Resend, e.g. "Portfolio Contact <contact@yourdomain.com>".
# For a quick test you can use "Portfolio Contact <onboarding@resend.dev>",
# but Resend only delivers that sender to the Resend account owner's address.
RESEND_FROM_EMAIL="Portfolio Contact <contact@yourdomain.com>"
